# Copy to .env and fill in. Never commit .env.

# Anthropic API key — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Model id used for the event-definition reasoning step.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Notion approval board — server-side only. Leave blank to skip the push.
NOTION_TOKEN=
NOTION_APPROVAL_DB_ID=

# Who is acting. Unset, every route but /health answers 401.
# "local" is for localhost only: every audit entry records LOCAL_IDENTITY_EMAIL as the
# actor, marked as unverified.
AUTH_MODE=local
LOCAL_IDENTITY_EMAIL=you@example.com

# SQLite file path (created on first run).
DATABASE_PATH=backend/data/continental_divide.db

# Max characters accepted in a raw intake request.
MAX_INTAKE_CHARS=2000

# Rate limit for POST /requests: max requests per window, window in seconds.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# Where the Next.js client should reach the API (browser-visible, no secrets).
NEXT_PUBLIC_API_BASE=http://localhost:8000
