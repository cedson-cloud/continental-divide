# Copy to .env and fill in. Never commit .env.

# Anthropic API key — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Model id used for the event-definition reasoning step.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Notion approval board — server-side only. Leave blank to skip the push.
NOTION_TOKEN=
NOTION_APPROVAL_DB_ID=

# Who is acting. Unset, every route but /health answers 401.
# "local" is for localhost only: every audit entry records LOCAL_IDENTITY_EMAIL as the
# actor, marked as unverified.
AUTH_MODE=local
LOCAL_IDENTITY_EMAIL=you@example.com

# "demo" is for the public demo (docs/adr/0010): each anonymous visitor gets a private
# sandbox, a SQLite file of its own under SANDBOX_DIR, named by a signed cookie.
# DEMO_COOKIE_SECRET must be at least 32 random characters, or every route answers 401.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# DEMO_COOKIE_SECURE=false only for plain-http testing on localhost.
DEMO_COOKIE_SECRET=
DEMO_COOKIE_SECURE=true
SANDBOX_DIR=backend/data/sandboxes
# A sandbox unused this many days is deleted, whole file, when the next new one is issued.
# Demo mode never pushes to Notion, whatever NOTION_TOKEN holds.
DEMO_SANDBOX_IDLE_DAYS=7

# The demo's spend controls. Demo mode calls the model only when the budget and both
# prices are above 0: look up the per-million-token prices for ANTHROPIC_MODEL on Anthropic's
# pricing page. Spend is counted per UTC day in SPEND_LEDGER_PATH.
DEMO_REQUESTS_PER_VISITOR=5
DEMO_DAILY_BUDGET_USD=0
MODEL_INPUT_USD_PER_MTOK=0
MODEL_OUTPUT_USD_PER_MTOK=0
SPEND_LEDGER_PATH=backend/data/model_spend.db
# New sandboxes per client address per hour, and across everyone per hour.
DEMO_SESSIONS_PER_IP_PER_HOUR=10
DEMO_SESSIONS_PER_HOUR=300
# The header the frontend host puts the visitor's address in. Leave blank on localhost.
DEMO_CLIENT_IP_HEADER=
# Sent by the frontend host's proxy as X-Demo-Proxy-Secret. Generate it the same way as
# DEMO_COOKIE_SECRET, and set the same value on both hosts.
DEMO_PROXY_SECRET=
# GET /demo/echo reports which forwarding headers, address candidates and cookies reach
# the backend, and whether the proxy secret matched. Turn on only while checking a deploy.
DEMO_ECHO_ROUTE=false

# Largest request body accepted on any route, in bytes.
MAX_REQUEST_BYTES=65536

# SQLite file path (created on first run).
DATABASE_PATH=backend/data/continental_divide.db

# Max characters accepted in a raw intake request.
MAX_INTAKE_CHARS=2000

# Rate limit for POST /requests: max requests per window, window in seconds.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit over every other route, reads included, per workspace cookie (per client
# address when there is none). /health and POST /session are outside it.
GENERAL_RATE_LIMIT_MAX=120
GENERAL_RATE_LIMIT_WINDOW_SECONDS=60

# Where the Next.js client should reach the API (browser-visible, no secrets).
NEXT_PUBLIC_API_BASE=http://localhost:8000
