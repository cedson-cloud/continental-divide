{
  "spec": "Segment Ecommerce V2 (public spec)",
  "naming_convention": "Object Action, Title Case (Segment Track spec)",
  "notes": "Sample, generic tracking plan. Property names are snake_case. Collection events reference the shared 'product_item' shape via array properties to reduce repetition; single-product events carry the product fields inline as Segment flattens them onto the event. Event descriptions are transcribed verbatim from the public Segment V2 Ecommerce spec.",
  "product_item": {
    "description": "Shared product shape reused by product and collection events.",
    "properties": [
      { "name": "product_id", "type": "string" },
      { "name": "sku", "type": "string" },
      { "name": "category", "type": "string" },
      { "name": "name", "type": "string" },
      { "name": "brand", "type": "string" },
      { "name": "variant", "type": "string" },
      { "name": "price", "type": "number" },
      { "name": "quantity", "type": "integer" },
      { "name": "coupon", "type": "string" },
      { "name": "position", "type": "integer" },
      { "name": "url", "type": "string" },
      { "name": "image_url", "type": "string" }
    ]
  },
  "categories": {
    "Browsing": [
      {
        "name": "Products Searched",
        "description": "User searched for products",
        "properties": [
          { "name": "query", "type": "string" }
        ]
      },
      {
        "name": "Product List Viewed",
        "description": "User viewed a product list or category",
        "properties": [
          { "name": "list_id", "type": "string" },
          { "name": "category", "type": "string" },
          { "name": "products", "type": "array", "items": "product_item" }
        ]
      },
      {
        "name": "Product List Filtered",
        "description": "User filtered a product list or category",
        "properties": [
